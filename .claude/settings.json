{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(node scripts/verify-browser.mjs *)",
      "Bash(node scripts/check-snippets.mjs *)",
      "Bash(node scripts/check-tokens.mjs *)",
      "Bash(bash scripts/build-min.sh *)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:caniuse.com)",
      "WebFetch(domain:web.dev)",
      "WebFetch(domain:webstatus.dev)",
      "WebFetch(domain:www.w3.org)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(npm publish *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git.sh" }
        ]
      }
    ]
  }
}
